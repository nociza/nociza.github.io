{
  "name": "nociza.github.io",
  "version": "1.0.0",
  "private": true,
  "_comment": "Force deployment trigger",
  "description": "nociza.github.io",
  "author": "nociza",
  "keywords": [
    "nextjs",
    "personal-website"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "npm run validate:content && npm run generate-sitemap && next build",
    "build:static": "npm run validate:content && npm run generate-sitemap && next build",
    "start": "next start",
    "lint": "next lint",
    "export": "npm run validate:content && npm run generate-sitemap && next build",
    "validate:content": "npm run validate:sips && npm run validate:reads",
    "validate:sips": "node scripts/validate-sips.mjs",
    "validate:reads": "node scripts/validate-reads.mjs",
    "fetch:read-covers": "node scripts/fetch-read-covers.mjs",
    "generate-sitemap": "node scripts/generate-sitemap.js",
    "deploy": "npm run export && touch out/CNAME && echo 'www.nociza.com' > out/CNAME && gh-pages -d out -t true",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@radix-ui/react-slot": "^1.2.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^10.16.16",
    "lucide-react": "^0.303.0",
    "next": "^14.0.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-icons": "^4.12.0",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.5",
    "@types/react": "^18.2.45",
    "@types/react-dom": "^18.2.18",
    "autoprefixer": "^10.4.16",
    "eslint": "^8.56.0",
    "eslint-config-next": "^14.0.4",
    "gh-pages": "^6.1.1",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.4.0",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.3.3"
  }
}
