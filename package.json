{
  "name": "nociza.github.io",
  "version": "1.0.0",
  "private": true,
  "_comment": "Force deployment trigger",
  "description": "nociza.github.io",
  "author": "nociza",
  "keywords": [
    "nextjs",
    "personal-website"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "npm run validate:content && npm run images:build && npm run generate-sitemap && next build --webpack",
    "build:static": "npm run build",
    "start": "next start",
    "lint": "eslint src",
    "export": "npm run build",
    "images:build": "node scripts/build-image-variants.mjs",
    "predev": "npm run images:build",
    "validate:content": "npm run validate:setups && npm run validate:sips && npm run validate:reads",
    "validate:setups": "node scripts/validate-brew-setups.mjs",
    "validate:sips": "node scripts/validate-sips.mjs",
    "validate:reads": "node scripts/validate-reads.mjs",
    "fetch:read-covers": "node scripts/fetch-read-covers.mjs",
    "generate-sitemap": "node scripts/generate-sitemap.js",
    "deploy": "npm run export && touch out/CNAME && echo 'www.nociza.com' > out/CNAME && gh-pages -d out -t true",
    "typecheck": "npm run images:build && next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@radix-ui/react-slot": "^1.2.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "13.2.0",
    "lucide-react": "1.27.0",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-icons": "^4.12.0",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.5",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "autoprefixer": "^10.4.16",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.5",
    "gh-pages": "^6.1.1",
    "postcss": "^8.4.32",
    "sharp": "0.35.4",
    "tailwindcss": "^3.4.0",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.3.3"
  }
}
